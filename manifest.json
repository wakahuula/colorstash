{
  "name": "Color Stash",
  "short_name": "Color Stash",
  "description": "A tiny, private color tool. Build a personal bank of hex colors, preview them live, and jump back to them instantly.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c0c0d",
  "theme_color": "#0c0c0d",
  "categories": ["utilities", "productivity", "graphics"],
  "share_target": {
    "action": "./__share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "./src/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./src/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
